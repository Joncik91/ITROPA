# Server-side only. Read by the Vercel functions in /api and by the Vite dev
# middleware during `npm run dev`. Never prefix these with VITE_ — that would
# ship them to the browser.

# Provider: "anthropic" (default) or "gemini". If unset: Anthropic, unless only
# GEMINI_API_KEY is set.
# AI_PROVIDER=anthropic

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: model override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini: Google AI Studio key (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
